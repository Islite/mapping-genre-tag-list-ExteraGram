    {
      "key": "anime_commands",
      "text": "Команды поиска аниме",
      "default": ".а, .аниме, .a, .anime",
      "subtext": "Поиск по названию и ID",
      "icon": "msg_search",
      "link_alias": "anime_commands",
      "group": "root"
    },
    {
      "key": "tag_commands",
      "text": "Команды поиска по тегу/жанру",
