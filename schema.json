    {
      "key": "primary_source",
      "text": "Основной поисковик",
      "default": 0,
      "items": ["AniList", "Shikimori"],
      "link_alias": "primary_source",
      "group": "search"
    },
    {
      "key": "search_ui_mode",
      "text": "Режим поиска",
      "default": 0,
      "items": ["Окно выбора", "Первое совпадение"],
      "link_alias": "search_ui_mode",
      "group": "search"
    },
    {
      "key": "direct_id_source",
      "text": "Источник ID",
      "default": 0,
      "items": ["AniList", "Shikimori"],
      "link_alias": "direct_id_source",
      "group": "search"
    },
    {
      "key": "extra_ru_count",
      "text": "Max русских названий",
      "default": 1,
      "items": ["0", "1", "2", "3", "4", "5"],
      "link_alias": "extra_ru_count",
      "group": "extra"
    },
    {
      "key": "extra_en_count",
      "text": "Max английских названий",
      "default": 1,
      "items": ["0", "1", "2", "3", "4", "5"],
      "link_alias": "extra_en_count",
      "group": "extra"
    },
    {
      "key": "description_in_card",
      "text": "Способ отправки описания",
      "default": 0,
      "items": ["В карточке", "Отдельно"],
      "link_alias": "description_in_card",
      "group": "display"
    },
    {
      "key": "desc_source",
      "text": "Источник описания",
      "default": 0,
      "items": ["Shikimori", "AniList"],
      "link_alias": "desc_source",
      "group": "display"
    },
    {
      "key": "empty_ph_space_mode",
      "text": "Удаление пробела",
      "default": 0,
      "items": ["После плейсхолдера", "До плейсхолдера"],
      "link_alias": "empty_ph_space_mode",
      "group": "format"
    }
  ],
  "layout": {
    "root": ["anime_commands", "tag_commands"],
    "search": ["use_anilist", "use_shikimori", "primary_source", "search_ui_mode", "direct_id_source"],
    "mappings": ["universal_mapping"],
    "appearance": ["card_template"],
    "extra_links": ["anilist_link_text", "shikimori_link_text"],
    "extra": ["spoiler_format", "ona_clarify", "show_separators", "extra_ru_count", "extra_en_count"],
    "display": [
      "show_anime_label", "show_flag", "show_country", "show_season", "show_year", "show_year_g",
      "show_format", "show_demographic", "show_episodes", "show_score", "show_status",
      "show_duration", "show_source", "show_studios",
      "show_genres", "show_genres_main", "show_genres_unlisted",
      "show_tags", "show_tags_main", "show_tags_unlisted",
      "show_link_in_full", "show_shikimori_link",
      "show_description", "description_in_card", "desc_source"
    ],
    "hash": [
      "show_hash_anime", "hash_country", "hash_format", "hash_demographic",
      "hash_studios", "hash_source", "hash_status",
      "hash_genres", "hash_genres_main", "hash_genres_unlisted",
      "hash_tags", "hash_tags_main", "hash_tags_unlisted"
    ],
    "under": [
      "underscore_format", "underscore_studios", "underscore_source", "underscore_status",
      "underscore_genres", "underscore_genres_main", "underscore_genres_unlisted",
      "underscore_tags", "underscore_tags_main", "underscore_tags_unlisted"
    ],
    "comma": [
      "comma_genres", "comma_genres_main", "comma_genres_unlisted",
      "comma_tags", "comma_tags_main", "comma_tags_unlisted",
      "comma_studios"
    ],
    "html_card": ["enable_html_card"],
    "html_desc": ["enable_html_desc"],
    "format": ["empty_ph_space_mode"]
  }
}
